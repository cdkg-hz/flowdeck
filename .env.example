# Local preview: separate from the live database. Demo mode never runs a Worker.
APP_MODE=demo
DATABASE_URL=sqlite:///./data/flowdeck.db
CONFIG_PATH=config/projects.yml
DATA_ROOT=./data
WORKSPACE_HOST_ROOT=

# Generate once with python -m backend.cli generate-key. Keep and back up this key.
SECRETS_ENCRYPTION_KEY=
# Public HTTPS base; project URLs are generated from this, not the dashboard host.
WEBHOOK_PUBLIC_BASE_URL=
# JSON array of absolute paths, existing and mounted identically into API and Worker.
# Empty defaults to DATA_ROOT/projects; create this root before onboarding.
STORAGE_ROOTS=[]
# Set false only for an internal HTTP development dashboard; production HTTPS uses true.
SESSION_SECURE=true
SESSION_HOURS=8
# Live deployments should keep this true so the dashboard and read APIs require an admin session.
# GitHub webhooks remain reachable without login.
REQUIRE_LOGIN=true
# GitHub API Tokens and Webhook Secrets are now configured per project in the web UI.
GITHUB_API_URL=https://api.github.com
GITHUB_GIT_ORIGIN=https://github.com
EXECUTOR_WEBHOOK_SECRET=

# Model providers (Chat Completions base URL + API key + model) are configured
# via the Web Admin UI and encrypted with SECRETS_ENCRYPTION_KEY.
# The worker talks to them through the local Copilot CLI runtime (no Copilot subscription).

SYNC_INTERVAL_SECONDS=300
INITIAL_HISTORY_DAYS=90

# Docker Compose on a NAS/Linux host. Create this absolute directory first.
# Layout: HOST_DATA_ROOT/postgres/ (database) and HOST_DATA_ROOT/projects/ (git workspaces).
# Back up this directory together with this .env file (SECRETS_ENCRYPTION_KEY).
# Do not onboard a project under HOST_DATA_ROOT/postgres.
HOST_DATA_ROOT=/srv/flowdeck
WORKFLOW_UID=1000
WORKFLOW_GID=1000
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080
POSTGRES_PASSWORD=
